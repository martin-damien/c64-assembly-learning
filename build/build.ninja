################################################################################
# BUILD FILE
# generated file: DO NOT EDIT!
################################################################################

ninja_required_version = 1.3
toolkit = kick
machine = 
format = prg
basedir = /home/damien/Dev/asm
builddir = /home/damien/Dev/asm/build

project = asm
config = /home/damien/Dev/asm/project-config.json
target = /home/damien/Dev/asm/build/asm.prg
dbg_out = /home/damien/Dev/asm/build/asm.dbg
python_exe = python3
java_exe = java
rc_exe = /home/damien/.vscode/extensions/rosc.vs64-2.6.2/tools/rc.py
rc_flags = --format kick --config "$config"
build_flags = 
asm_exe = /home/damien/Applications/kickass/KickAss.jar
asminfo = /home/damien/Dev/asm/build/asm.info

flags = -debugdump -asminfo "files|errors" -debug
includes = -libdir /home/damien/Dev/asm -libdir /home/damien/Dev/asm/build
defs = -define DEBUG -define __kick__ -define DEBUG

rule res
    command = $python_exe $rc_exe $rc_flags -o $out $in

rule asm
    depfile = $out.d
    deps = gcc
    command = $java_exe -jar $asm_exe -odir "$builddir" -asminfofile "$asminfo" $flags $includes -o $out $in


build $target | $dbg_out : asm /home/damien/Dev/asm/src/main.asm | 

build all: phony $target
default all
